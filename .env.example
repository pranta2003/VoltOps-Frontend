# VoltOps Frontend Environment Configuration Template
# Copy this file to ".env" in local development and configure values.
# NEVER commit actual API keys, secrets, or service account credentials.

# ── Backend API ─────────────────────────────────────────────────────────────
# Base URL for the future VoltOps backend API service.
VITE_API_URL="http://localhost:5000/api"

# ── Firebase Authentication (Client-side Google Identity) ───────────────────
# Create a web application in the Firebase Console (https://console.firebase.google.com).
# Enable Google provider under Authentication -> Sign-in method.
# Add your local domain (e.g., localhost) to Authorized Domains.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
